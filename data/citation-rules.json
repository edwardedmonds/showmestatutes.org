{
  "schemaVersion": 1,
  "revisorOrigin": "https://revisor.mo.gov",
  "chapterPattern": "[1-9][0-9]{0,2}",
  "standardSectionSuffixPattern": "[0-9]{3,4}",
  "versionIdPattern": "[0-9]+",
  "isoDatePattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}",
  "sha256Pattern": "[a-f0-9]{64}",
  "sectionQueryPattern": "^(?:(?:rsmo|section)\\s*|§\\s*)*([0-9]{1,3}\\.[0-9]{1,4}(?:[a-z]?-[0-9]{1,4}[a-z]?)?)\\.?$",
  "chapterSectionRules": {
    "400": {
      "allowStandard": false,
      "extraPatterns": [
        "400\\.(?:[1-9]|1[01]|[24]A)-[0-9]{3}"
      ]
    },
    "409": {
      "allowStandard": true,
      "extraPatterns": [
        "409\\.[1-7]-[0-9]{3}"
      ]
    },
    "448": {
      "allowStandard": true,
      "extraPatterns": [
        "448\\.[1-4]-[0-9]{3}"
      ]
    },
    "456": {
      "allowStandard": true,
      "extraPatterns": [
        "456\\.(?:[1-8]-[0-9]{3}|4-411[AB]|1[01]-[0-9]{4})"
      ]
    }
  }
}
